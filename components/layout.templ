package components

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title + " – cody say" }</title>
			<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
			<link rel="preload" href="/fonts/nunito-sans.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="/css/style.css"/>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.17.5/dist/cdn.min.js"></script>
			<script>
				function setTheme(theme) {
					document.documentElement.dataset.theme = theme
					document.querySelector("link[rel=icon]").href = theme === "auto" ? "/favicon.svg" : "/favicon-" + theme + ".svg"
				}
				setTheme(localStorage.theme || "auto")
			</script>
		</head>
		<body class="bg-background text-foreground selection:bg-foreground selection:text-background mx-auto flex min-h-dvh max-w-3xl flex-col p-4 lowercase">
			@Navbar()
			<main class="flex-1">
				{ children... }
			</main>
			@Footer()
		</body>
	</html>
}
