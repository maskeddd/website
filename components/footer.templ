package components

var themes = []string{"auto", "light", "dark"}

templ Footer() {
	<footer
		class="pt-12 pb-8 text-center"
		x-data="{ theme: document.documentElement.dataset.theme }"
		x-effect="setTheme(theme); localStorage.theme = theme"
	>
		<ul class="divided flex justify-center gap-2">
			for _, t := range themes {
				<li>
					<button
						type="button"
						x-on:click={ "theme = '" + t + "'" }
						x-bind:aria-pressed={ "theme === '" + t + "'" }
						class="text-foreground/60 aria-pressed:text-foreground"
					>{ t }</button>
				</li>
			}
		</ul>
	</footer>
}
