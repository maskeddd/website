package components

import "strings"

var themes = []string{"Auto", "Light", "Dark"}

templ Footer() {
	<footer
		x-data="{ theme: document.documentElement.dataset.theme }"
		x-effect="setTheme(theme); localStorage.theme = theme"
	>
		<ul class="divided">
			for _, t := range themes {
				<li>
					<button
						type="button"
						x-on:click={ "theme = '" + strings.ToLower(t) + "'" }
						x-bind:aria-pressed={ "theme === '" + strings.ToLower(t) + "'" }
					>{ t }</button>
				</li>
			}
		</ul>
	</footer>
}
