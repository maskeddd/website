package components

type NavLink struct {
	Label string
	Href  string
}

templ Navbar() {
	<header>
		<a href="/"><h1>Cody Say</h1></a>
		<nav>
			<ul class="divided">
				for _, link := range NavLinks(ctx) {
					<li>
						<a
							href={ link.Href }
							if link.Href == CurrentPath(ctx) {
								aria-current="page"
							}
						>{ link.Label }</a>
					</li>
				}
			</ul>
		</nav>
	</header>
}
