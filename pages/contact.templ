package pages

import "website/components"

const (
	email  = "me@indent.lol"
	github = "github.com/maskeddd"
)

templ Contact() {
	@components.Layout("contact") {
		<div class="contact">
			@components.ExternalLink("mailto:" + email) {
				{ email }
			}
			@components.ExternalLink("https://" + github) {
				{ github }
			}
		</div>
	}
}
